# VidyaSaathi Backend Configuration
APP_NAME=VidyaSaathi
APP_ENV=development
PORT=8000
DEBUG=True

# Database (SQLite default for easy setup, can switch to postgresql://user:pass@localhost:5432/vidyasaathi)
DATABASE_URL=sqlite:///./vidyasaathi.db

# JWT Security
SECRET_KEY=supersecretkey_vidyasaathi_jwt_secret_token_2025_rural_edu
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IBM watsonx.ai Configuration
# If left empty, MockProvider will be activated automatically for offline & local demos
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
